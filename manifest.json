{
  "manifest_version": 3,
  "name": "Keep (keep.booq.cc)",
  "description": "One click: send this page to Karakeep at keep.booq.cc. No popups.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/logo-16.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "Save to Karakeep",
    "default_icon": {
      "16": "icons/logo-16.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://keep.booq.cc/*"]
}
